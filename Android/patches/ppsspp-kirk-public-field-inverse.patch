diff --git a/ext/libkirk/bn.c b/ext/libkirk/bn.c
index d0d859f..187c4a7 100644
--- a/ext/libkirk/bn.c
+++ b/ext/libkirk/bn.c
@@ -201,3 +201,75 @@ void bn_mon_inv(u8 *d, const u8 *a, const u8 *N, u32 n)
 	bn_sub_1(t, N, s, n);
 	bn_mon_exp(d, a, N, n, t, n);
 }
+
+/* Binary extended GCD for the fixed KIRK field. Other moduli keep the original path. */
+static void bn_shift_right(u8 *d, u32 n, u8 carry)
+{
+	for (u32 i = 0; i < n; i++) {
+		u8 next = d[i] & 1;
+		d[i] = (d[i] >> 1) | (carry << 7);
+		carry = next;
+	}
+}
+
+static int bn_is_one(const u8 *a, u32 n)
+{
+	for (u32 i = 0; i + 1 < n; i++) {
+		if (a[i]) {
+			return 0;
+		}
+	}
+	return a[n - 1] == 1;
+}
+
+static int bn_kirk_field_inv(u8 *d, const u8 *a, const u8 *N, u32 n)
+{
+	static const u8 field[20] = {0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0,0,0,1,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff};
+	if (n != 20 || memcmp(N, field, 20) || bn_compare(a, N, n) >= 0) {
+		return 0;
+	}
+	u8 u[20], v[20], x[20] = {0}, y[20] = {0};
+	bn_copy(u, a, n);
+	bn_from_mon(u, N, n);
+	bn_copy(v, N, n);
+	x[n - 1] = 1;
+	unsigned budget = 2048;
+	while (!bn_is_one(u, n) && !bn_is_one(v, n)) {
+		while (!(u[n - 1] & 1)) {
+			if (!budget--) {
+			return 0;
+		}
+			bn_shift_right(u, n, 0);
+			u8 carry = (x[n - 1] & 1) ? bn_add_1(x, x, N, n) : 0;
+			bn_shift_right(x, n, carry);
+		}
+		while (!(v[n - 1] & 1)) {
+			if (!budget--) {
+			return 0;
+		}
+			bn_shift_right(v, n, 0);
+			u8 carry = (y[n - 1] & 1) ? bn_add_1(y, y, N, n) : 0;
+			bn_shift_right(y, n, carry);
+		}
+		if (!budget--) {
+			return 0;
+		}
+		if (bn_compare(u, v, n) >= 0) {
+			bn_sub_1(u, u, v, n);
+			bn_sub(x, x, y, N, n);
+		} else {
+			bn_sub_1(v, v, u, n);
+			bn_sub(y, y, x, N, n);
+		}
+	}
+	bn_copy(d, bn_is_one(u, n) ? x : y, n);
+	bn_to_mon(d, N, n);
+	return 1;
+}
+
+void bn_mon_inv_public(u8 *d, const u8 *a, const u8 *N, u32 n)
+{
+	if (!bn_kirk_field_inv(d, a, N, n)) {
+		bn_mon_inv(d, a, N, n);
+	}
+}
